# ============================================================================
# FinWise AI — client-safe environment template (Phase 3A)
# ============================================================================
#
# Variable NAMES only. No real values belong in this file or in source control.
#
# Usage:
#   1. copy this file to `.env.local` (git-ignored)
#   2. fill in the values from your Supabase project dashboard
#      (Project Settings -> API)
#   3. restart `npm run dev`
#
# Everything prefixed with VITE_ is inlined into the browser bundle and is
# therefore PUBLIC. Only the anon/publishable key may live here.
#
# NEVER put any of the following in a VITE_ variable:
#   * the Supabase service-role key (it bypasses Row Level Security)
#   * the database password or connection string
#   * AI provider secret keys (Gemini / OpenAI / Claude)
#   * any other privileged server credential
#
# Those belong to the FinWise backend / secure server boundary and are read
# there from non-VITE_ (server-only) variables.
# ============================================================================

# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Public Supabase anon/publishable key. Every request stays subject to the
# Row Level Security policies in supabase/migrations/.
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# Server-side only (NOT read by the frontend — listed here for completeness).
# Configure these in the backend/hosting provider secrets manager, never in a
# VITE_ variable and never in source control.
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# ----------------------------------------------------------------------------
# finwise-copilot Edge Function secrets (Phase 3C secure AI boundary).
# Set them with the Supabase CLI — the values never touch this repo or the
# browser bundle:
#
#   supabase secrets set AI_PROVIDER=gemini AI_MODEL=gemini-2.0-flash \
#     AI_PROVIDER_API_KEY=<secret>
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected into the Edge Function
# runtime automatically by Supabase and must not be set manually.
# Until AI_PROVIDER_API_KEY is set, the function answers 503 honestly.
# ----------------------------------------------------------------------------
# AI_PROVIDER=gemini        # gemini | openai | claude
# AI_MODEL=gemini-3.8-flash
# AI_PROVIDER_API_KEY=